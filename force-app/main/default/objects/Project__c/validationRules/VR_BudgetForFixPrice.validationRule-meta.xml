<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_BudgetForFixPrice</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 ISPICKVAL(Type__c, &apos;Fixprice&apos;),
 OR (ISBLANK(Budget__c),Budget__c = null, Budget__c&lt;=0)
)</errorConditionFormula>
    <errorDisplayField>Budget__c</errorDisplayField>
    <errorMessage>Budget must be defined fot the Fixprice projects</errorMessage>
</ValidationRule>
